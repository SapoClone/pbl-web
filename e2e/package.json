{
  "name": "pbl-web-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright end-to-end tests for the tenant web app (own package so the app's yarn lockfile and CI stay untouched)",
  "scripts": {
    "test": "E2E_FRESH=1 playwright test",
    "test:spec": "playwright test",
    "test:headed": "E2E_FRESH=1 playwright test --headed",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
